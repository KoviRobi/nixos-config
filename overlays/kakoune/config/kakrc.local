# vi: filetype=kak

colorscheme %sh{
  if [ "$(tput colors)" -eq 8 ]; then
    echo plain
  else
    echo "gruvbox-$(cat ~/.local/state/brightness || echo light)";
  fi
}
face global Information MenuBackground

# To parse lines like `# vi: filetype=kak
hook global BufOpenFile .* %{ modeline-parse }

add-highlighter global/pairs show-matching
add-highlighter global/show-trailing-whitespaces regex '\h+$' 0:,rgba:80000040,red+c
add-highlighter global/show-inconsistent-space-tab regex '( +)(\t+)' 2:,rgba:80000040,red+c
add-highlighter global/show-inconsistent-tab-space regex '(\t+)( +)' 1:,rgba:80000040,red+c

define-command wrap "add-highlighter global/wrap wrap -word -marker ⏎"
define-command nowrap "remove-highlighter global/wrap"
define-command hl "add-highlighter global/highlight-search dynregex '%%reg{/}' 0:,rgba:80800040+i"
define-command nohl "remove-highlighter global/highlight-search"
wrap
hl

set-option global startup_info_version 20250603

set-option global scrolloff 3,2

# UI options
set-option global ui_options \
    terminal_set_title=true \
    terminal_status_on_top=true \
    terminal_assistant=none \
    terminal_enable_mouse=true \
    terminal_change_colors=true \
    terminal_builtin_key_parser=false

require-module man-improved

require-module c-w_and_c-u
map global insert <c-u> '<a-;>: erase_characters_before_cursor_to_line_begin<ret>'
map global insert <c-w> '<a-;>: erase_word_before_cursor<ret>'

require-module lsp

require-module zmx-repl

define-command mkdir %{ nop %sh{ mkdir -p $(dirname $kak_buffile) } }

# Shortcut to quickly exit the editor
define-command -docstring "save and quit" x "write; delete-buffer"
define-command -docstring "save and quit" xa "write-all-quit"

define-command \
    -docstring "Run a command" \
    -params .. \
    -shell-completion run %{ echo -debug %sh{ ${@} } }

# Subject-verb
alias global bd delete-buffer
alias global bd! delete-buffer!

# Use OSC 52, works through SSH also
hook global NormalKey y|d|c %{
    nop %sh{
        encoded=$(printf %s "$kak_reg_dquote" | base64 | tr -d '\n')
        printf "\e]52;;%s\e\\" "$encoded" >/dev/tty
    }
}

hook global WinCreate ^[^*]+$ %{editorconfig-load}

alias global qa kill
alias global qa! kill!

define-command -docstring "quit with status 1" "cq" "quit 1"
define-command -docstring "quit! with status 1" "cq-force" "quit! 1"
alias global cq! cq-force

set-option global grepcmd "rg --vimgrep"

map global user f ': fzf-mode<ret>' -docstring "FZF mode"

map global insert <c-d> '<a-;><lt>'
map global insert <c-t> '<a-;><gt>'
map global insert <a-d> '<a-;><a-lt>'
map global insert <a-t> '<a-;><a-gt>'

# TODO: Show details
# set global make_error_pattern '^([^:\n]+):(\d+):(?:(\d+):)? (?i)(?:fatal )?(fail(ed|ure)|error|warn(ing)?|info|note):?([^\n]+)?'

# For active-window-kak
set-face global InactiveCursor rgba:80808040,rgba:80808040

hook global WinDisplay .* %{
  set-option -add global ui_options "terminal_title=%val{buffile}"
}

hook global WinSetOption filetype=git-commit %{
    spell
    set buffer autowrap_column 72
    autowrap-enable
    add-highlighter buffer/git-subject column 50 default,rgba:80000020
    add-highlighter buffer/git-body column 72 default,rgba:80000020
}

define-command -hidden git-rebase-alternative-file %{
    evaluate-commands %sh{
        file="${kak_buffile##*/}"
        dir=$(dirname "$kak_buffile")
        case "$file" in
        done)            echo "edit %{$dir/git-rebase-todo}" ;;
        git-rebase-todo) echo "edit %{$dir/done}"            ;;
        *)               echo "fail 'no alternative file'" ;;
        esac
    }
}

# Run `git show <hash>` on git rebase lines (e.g. `pick <hash>`)
define-command -hidden git-show-rebase-hash %{
    evaluate-commands -save-regs h %{
        execute-keys -draft %{ghwe: set-register h %reg{.}<ret>}
        git show %reg{h}
    }
}

hook global WinSetOption filetype=git-rebase %{
    map buffer goto "'" '<esc>: git-rebase-alternative-file<ret>' -docstring 'Git rebase todo/done'
    map buffer normal <ret> '<esc>: git-show-rebase-hash<ret>' -docstring 'Jump to hash under the cursor'
}

hook global BufCreate .*/rebase-merge/done %{
    set-option buffer filetype git-rebase
}

hook global WinSetOption filetype=nix %{
  set-option window indentwidth 2
}
